<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. Pure black rather than the app's near-black chrome
  colour: the launcher composites the layers over its own surface and applies a
  mask, so a non-opaque or light background shows as a pale ring around the
  artwork.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
