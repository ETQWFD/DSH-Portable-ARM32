<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/bar_fg"
            android:text="@string/settings_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textSize="13sp"
            android:textColor="@color/bar_fg"
            android:text="@string/settings_port" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@color/field_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="number"
            android:maxLength="5"
            android:textSize="14sp"
            android:textColor="@color/bar_fg"
            android:textColorHint="@color/bar_fg_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/bar_fg_dim"
            android:text="@string/settings_port_hint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#22FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/bar_fg"
            android:text="@string/settings_backend" />

        <TextView
            android:id="@+id/textRootfsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/bar_fg_dim" />

        <Button
            android:id="@+id/btnReinstall"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="@color/err"
            android:background="@color/field_bg"
            android:text="@string/settings_reinstall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/bar_fg_dim"
            android:text="@string/settings_reinstall_note" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#22FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/bar_fg"
            android:text="@string/settings_mounts" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/bar_fg_dim"
            android:text="@string/settings_mounts_note" />

        <LinearLayout
            android:id="@+id/mountList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnGrantStorage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="@color/bar_fg"
            android:background="@color/field_bg"
            android:text="@string/settings_mount_grant" />

        <Button
            android:id="@+id/btnAddMount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/bar_fg"
            android:background="@color/field_bg"
            android:text="@string/settings_mount_add" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#22FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/bar_fg"
                    android:text="@string/settings_keepalive" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/bar_fg_dim"
                    android:text="@string/settings_keepalive_note" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchKeepAlive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#22FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/bar_fg"
            android:text="@string/settings_about" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/bar_fg"
            android:background="@color/field_bg"
            android:text="@string/about_entry" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="28dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:background="@color/accent"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/bar_fg"
                android:background="@color/field_bg"
                android:text="@string/settings_reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/bar_fg_dim" />
    </LinearLayout>
</ScrollView>
