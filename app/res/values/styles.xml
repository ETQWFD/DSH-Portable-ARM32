<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/scrim</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bar_bg</item>
        <item name="android:colorPrimaryDark">@color/scrim</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Compact key for the terminal's extra row; selection marks an armed modifier. -->
    <style name="TerminalKey" parent="@android:style/Widget.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bar_fg</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>
</resources>
